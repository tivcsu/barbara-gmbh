# Public production origin used for canonical links, sitemap and robots.
# Keep this unset in deploy previews so they remain noindex.
SITE_URL=https://www.your-domain.at

# Resend
RESEND_API_KEY=re_replace_with_a_resend_api_key
CONTACT_FROM_EMAIL="Barbara GmbH <website@barbaragmbh.at>"
CONTACT_TO_EMAIL=office@barbaragmbh.at

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://replace-with-your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_your_upstash_rest_token

# Generate a unique value with at least 32 random characters.
# It is used only to HMAC-hash rate-limit identifiers before storage.
RATE_LIMIT_HASH_SECRET=replace_with_a_long_random_secret_at_least_32_characters
